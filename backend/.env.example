# BlockVideo backend env (no secrets in production use — BYOK is preferred)
APP_NAME=BlockVideo
ENVIRONMENT=development

# Storage
STORAGE_ROOT=../storage

# HTTP
API_HOST=127.0.0.1
API_PORT=8000

# By default the server proxies CORS for Vite dev servers on localhost.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional LLM fallbacks (only used if the project has not been supplied a BYOK
# key). Leave blank unless you intentionally want to bypass per-project config.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# D17 natural-language controls: leave the model blank to disable local inference.
# Separate from the video-generation LLM; credentials are never shared.
LANGUAGE_MODEL=
LANGUAGE_BASE_URL=http://127.0.0.1:1234/v1
LANGUAGE_REASONING_EFFORT=none
LANGUAGE_REVIEW_ALL=false

# D27 optional verified semantic index; keep unset for the existing All Tools flow.
# Install the retrieval extra and build the pinned index first (python -m scripts.operation_index build).
# LANGUAGE_RETRIEVAL_INDEX=storage/operation-index-e5
# LANGUAGE_RETRIEVAL_PROFILE=app/retrieval/e5-profile.json
# LANGUAGE_EMBEDDING_ASSETS=storage/embedding-models/multilingual-e5-small
# LANGUAGE_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# LANGUAGE_RETRIEVAL_ALL_TOOLS=true
# D28 provisional annotations; false preserves the D27 semantic baseline.
# LANGUAGE_RETRIEVAL_READINESS=true

# Optional image fallback.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1

# VOICEVOX defaults (URL, speaker and tuning).
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_ID=1
VOICEVOX_SPEED_SCALE=1.0
VOICEVOX_PITCH_SCALE=0.0
VOICEVOX_INTONATION_SCALE=1.0
VOICEVOX_VOLUME_SCALE=1.0

# Optional explicit ffmpeg / ffprobe paths.
# Leave blank to fall back to PATH lookup.
FFMPEG_PATH=
FFPROBE_PATH=
